function applyChange(resetScroll) {
    if (view === "stacks") updateStackHighlights();
    else render(resetScroll);
}

function render(resetScroll) {
    const arr = getFiltered();

    $("#shown").textContent = fmt(arr.length);
    $("#total").textContent = fmt(DATA.length);

    try {
        updateTopCounters();
    } catch (e) {
        console.warn("Счётчики не обновились", e);
    }

    const sp = $("#srcPill");
    if (sp) {
        sp.textContent = dataSource === "db" ? ("БД: " + fmt(DATA.length)) : ("ДЕМО: " + fmt(DATA.length));
        sp.classList.toggle("src-db", dataSource === "db");
    }

    $("#sortCtl").classList.toggle("dim-ctl", view === "stacks");
    yardWrap.classList.toggle("is-stacks", view === "stacks");

    const yh = $("#yardHint");
    if (yh) {
        yh.style.display = (view === "stacks" && dataSource === "demo") ? "inline-flex" : "none";
    }

    if (resetScroll) yard.scrollTop = 0;

    yard.onscroll = null;
    yard._v = null;

    if (!arr.length && view !== "stacks") {
        yard.innerHTML = `<div class="empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="2" y="6" width="20" height="12" rx="1.5"/>
                <path d="M6 6v12M10 6v12M14 6v12M18 6v12"/>
            </svg>
            <div>Под текущие фильтры контейнеров не нашлось.</div>
        </div>`;

        syncBulkUI();
        return;
    }

    if (view === "yard") {
        makeVirtual(yard, {
            rowH: ROWH.yard,
            columns: yardCols(),
            items: arr,
            buildItem: boxHTML,
            mode: "grid",
            fresh: resetScroll
        });
    } else if (view === "list") {
        makeVirtual(yard, {
            rowH: ROWH.list,
            columns: 1,
            items: arr,
            buildItem: rowHTML,
            mode: "col",
            fresh: resetScroll
        });
    } else if (view === "groups") {
        renderGroups(arr, resetScroll);
    } else {
        renderStacks();
    }

    syncBulkUI();
}

