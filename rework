function renderChain() {
    if (!editing) {
        $("#chainList").innerHTML = "";
        return;
    }

    let firstActive = true;

    $("#chainList").innerHTML = CHAIN.map((c, i) => {
        const done = c.done(editing);
        const active = !done && firstActive;

        if (active) firstActive = false;

        const cls = done ? "done" : (active ? "active" : "wait");

        return `<div class="step ${cls}" style="animation-delay:${i * 45}ms">
            <div class="rail">
                <div class="node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></div>
                <div class="line"></div>
            </div>
            <div class="body">
                <div class="st">${c.label}<span class="who">${c.who}</span></div>
                <div class="sm">${c.sm(editing)}</div>
            </div>
        </div>`;
    }).join("");
}

