async function bulkApply() {
    if (!canWrite()) {
        toast("Недостаточно прав для записи", true);
        return;
    }

    if (!selectedIds.size) return;

    const st = $("#bb-state").value;
    const pr = $("#bb-proc").value;
    const ow = $("#bb-owner").value;
    const kg = $("#bb-kgmk").value;

    if (!st && !pr && !ow && kg === "") {
        toast("Выберите хотя бы одно изменение", true);
        return;
    }

    const idsToUpdate = Array.from(selectedIds);
    let successCount = 0;

    idsToUpdate.forEach(id => {
        const d = DATA.find(x => x.id === id);
        if (!d) return;

        if (st) d.state = st;
        if (pr) d.procState = pr === "__none" ? "" : pr;
        if (ow) d.owner = ow;
        if (kg !== "") d.kgmk = kg === "1";
    });

    buildFacets();
    clearSelection();
    render(false);

    toast(`Обновление ${idsToUpdate.length} контейнеров...`);

    if (dataSource === "db") {
        try {
            const promises = idsToUpdate.map(id => {
                const d = DATA.find(x => x.id === id);
                if (!d) return Promise.resolve();

                const payload = {
                    state: d.state,
                    procState: d.procState,
                    responsible: d.owner,
                    isKgmk: d.kgmk
                };

                return fetch(`${API_BASE}/containers/${id}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                }).then(res => {
                    if (res.ok) successCount++;
                    else throw new Error(`Failed for ${id}`);
                });
            });

            await Promise.all(promises);

            toast(`Успешно обновлено: ${successCount}`);

            buildFacets();
            render(false);

        } catch (e) {
            console.error(e);
            toast("Ошибка при сохранении части контейнеров", true);
        }
    } else {
        toast(`Обновлено (демо): ${idsToUpdate.length}`);
    }

    ["#bb-state", "#bb-proc", "#bb-owner", "#bb-kgmk"].forEach(s => {
        $(s).value = "";
        $(s).classList.remove("touched");
    });
}

