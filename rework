async function enterPlan() {
    if (planMode || !canWrite()) return;

    factData = JSON.parse(JSON.stringify(DATA));

    try {
        const res = await fetch(`${API_BASE}/containers/plans`);

        if (res.ok) {
            const plans = await res.json();

            PLAN_DATA.clear();

            plans.forEach(p => {
                PLAN_DATA.set(p.id, { block: p.block, bay: p.bay, tier: p.tier });

                const container = DATA.find(d => d.id === p.id);

                if (container) {
                    container.block = p.block;
                    container.bay = p.bay;
                    container.tier = p.tier;
                }
            });
        }
    } catch (e) {
        console.warn("Ошибка загрузки планов, начинаем с факта", e);
    }

    LAYOUT = buildLayoutFromData(DATA);

    planUndo.length = 0;
    planRedo.length = 0;
    planMode = true;

    yardWrap.classList.add("plan-mode");
    yard.classList.add("plan-mode");

    const btn = $("#planBtn");
    btn.classList.add("plan-on");
    btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6 9 17l-5-5"/></svg>Применить план`;
    btn.title = "Применить план к факту";

    const cancelBtn = $("#cancelPlanBtn");
    if (cancelBtn) cancelBtn.style.display = "inline-flex";

    toast("Режим плана активен");
    render(false);
}

async function applyPlan() {
    if (!planMode) return;

    try {
        const res = await fetch(`${API_BASE}/containers/plans/apply`, { method: "POST" });
        if (!res.ok) throw new Error("Failed to apply");

        planMode = false;
        PLAN_DATA.clear();

        yardWrap.classList.remove("plan-mode");
        yard.classList.remove("plan-mode");

        const btn = $("#planBtn");
        btn.classList.remove("plan-on");
        btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l2.5 2.5M16.5 16.5 19 19M19 5l-2.5 2.5M7.5 16.5 5 19"/><circle cx="12" cy="12" r="3.2"/></svg>План`;

        const cancelBtn = $("#cancelPlanBtn");
        if (cancelBtn) cancelBtn.style.display = "none";

        toast("План применён. Перезагрузка данных...");

        await loadData();
        render(true);

    } catch (e) {
        console.error(e);
        toast("Ошибка применения плана", true);
    }
}

function cancelPlan() {
    if (!planMode) return;

    DATA = JSON.parse(JSON.stringify(factData));
    LAYOUT = buildLayoutFromData(DATA);

    planMode = false;
    PLAN_DATA.clear();

    yardWrap.classList.remove("plan-mode");
    yard.classList.remove("plan-mode");

    const btn = $("#planBtn");
    btn.classList.remove("plan-on");
    btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l2.5 2.5M16.5 16.5 19 19M19 5l-2.5 2.5M7.5 16.5 5 19"/><circle cx="12" cy="12" r="3.2"/></svg>План`;

    const cancelBtn = $("#cancelPlanBtn");
    if (cancelBtn) cancelBtn.style.display = "none";

