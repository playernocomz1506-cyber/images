function updateMassInfo() {
    const pw = +$("#f-pw").value || 0;
    const tare = $("#f-tare").value === "" ? null : +$("#f-tare").value;
    const gross = $("#f-gross").value === "" ? null : +$("#f-gross").value;

    const nEl = $("#f-netto");

    if (gross != null && tare != null) {
        const net = gross - tare;
        nEl.classList.remove("emp");
        nEl.querySelector(".nv").textContent = fmt(net) + " кг";
    } else {
        nEl.classList.add("emp");
        nEl.querySelector(".nv").textContent = "—";
    }

    const w = $("#w-info");

    if (pw > 0 && tare != null) {
        const diff = tare - pw;
        const pct = Math.round(diff / pw * 100);

        $("#w-info-txt").textContent = `Расхождение трафарет ↔ тара факт.: ${diff >= 0 ? "+" : ""}${fmt(diff)} кг (${pct >= 0 ? "+" : ""}${pct}%).`;
        w.classList.add("show");
    } else {
        w.classList.remove("show");
    }
}

async function openDrawer(id) {
    let d = DATA.find(x => x.id === id);
    if (!d) return;

    // Если запись временная — не дергаем API.
    if (dataSource === "db" && id > 0 && !d.isNew) {
        try {
            const res = await fetch(`${API_BASE}/containers/${id}`);
            if (res.ok) {
                const full = mapDto(await res.json());
                const idx = DATA.findIndex(x => x.id === id);
                if (idx >= 0) {
                    DATA[idx] = { ...DATA[idx], ...full };
                    d = DATA[idx];
                }
            }
        } catch (e) {
            console.warn("Не удалось догрузить полную карточку", e);
        }
    }

    clearSelection();

    selectedId = id;
    editing = JSON.parse(JSON.stringify(d));
    editingOld = JSON.parse(JSON.stringify(d));

    markSel(id);

    const s = stateOf(editing.state);

    $("#drawer").style.setProperty("--c", s.hex);
    $("#d-pre").textContent = editing.prefix || "----";
    $("#d-num").textContent = String(editing.number || "").slice(0, 6) || "000000";
    $("#d-iso").textContent = editing.iso || "—";

    $("#f-type").value = editing.typeLegacy || "";
    $("#f-iso").value = editing.iso || "";

    const cc = computedCheck(editing);
    const chkEl = $("#d-chk");
    const shown = editing.number ? String(editing.number)[6] : undefined;

    chkEl.textContent = shown ?? "–";
    chkEl.classList.toggle("bad", shown !== undefined && +shown !== cc);

    $("#d-st-dot").style.background = s.color;
    $("#d-st-name").textContent = s.name;

    const prw = $("#d-prc-wrap");
    const p = procOf(editing.procState);

    if (p) {
        prw.classList.remove("none");
        $("#d-prc-dot").style.display = "";
        $("#d-prc-dot").style.background = p.color;
        $("#d-prc-name").textContent = p.name;
        $("#d-prc-name").style.color = p.hex;
    } else {
        prw.classList.add("none");
        $("#d-prc-dot").style.display = "none";
        $("#d-prc-name").textContent = "не в операции";
        $("#d-prc-name").style.color = "";
    }

    const loc = $("#d-loc");

    if (editing.block) {
        loc.style.display = "";
        loc.textContent = `секция ${editing.block} · ряд ${pad2(editing.bay)} · ярус ${editing.tier}`;
    } else {
        loc.style.display = "none";
    }

    $("#f-pre").value = editing.prefix || "";
    $("#f-num").value = editing.number || "";
    $("#f-pw").value = editing.pw ?? "";
    $("#f-tare").value = editing.tareFact == null ? "" : editing.tareFact;
    $("#f-gross").value = editing.gross == null ? "" : editing.gross;
    $("#f-grep").value = editing.grossRepeat == null ? "" : editing.grossRepeat;

    fillSelect($("#f-state"), Object.values(STATES).map(s => s.name), s.name);
    fillSelect($("#f-proc"), ["— не в операции —", ...Object.values(PROC).map(p => p.name)], editing.procState ? procName(editing.procState) : "— не в операции —");

    const ownerOpts = OWNERS.length ? OWNERS.map(o => o.fullName) : ["Не назначен"];
    fillSelect($("#f-owner"), ownerOpts.concat(["Не назначен"]), editing.owner);

    $("#f-kgmk").checked = !!editing.kgmk;
    $("#f-ret").checked = !!editing.retired;
    $("#f-note").value = editing.note || "";

    applyRoleToDrawer();
    updateMassInfo();
    setTab("data");

    $("#drawer").classList.add("open");
    $("#scrim").classList.add("open");
    $("#drawer").setAttribute("aria-hidden", "false");
}

function closeDrawer() {
    $("#drawer").classList.remove("open");
    $("#scrim").classList.remove("open");
    $("#drawer").setAttribute("aria-hidden", "true");

    selectedId = null;
    markSel(null);

    editing = null;
    editingOld = null;
}

function valFromForm() {
    const procSel = $("#f-proc").value;
    const procKey = Object.keys(PROC).find(k => PROC[k].name === procSel) || "";

    const stSel = $("#f-state").value;
    const stKey = Object.keys(STATES).find(k => STATES[k].name === stSel) || "inuse";

    return {
        prefix: ($("#f-pre").value || "").toUpperCase().trim(),
        number: ($("#f-num").value || "").replace(/\D/g, "").trim(),

        typeLegacy: ($("#f-type").value || "").trim(),
        iso: ($("#f-iso").value || "").toUpperCase().trim(),

        pw: $("#f-pw").value === "" ? null : +$("#f-pw").value,
        tareFact: $("#f-tare").value === "" ? null : +$("#f-tare").value,
        gross: $("#f-gross").value === "" ? null : +$("#f-gross").value,
        grossRepeat: $("#f-grep").value === "" ? null : +$("#f-grep").value,

        state: stKey,
        procState: procKey,
        owner: $("#f-owner").value || "Не назначен",
        kgmk: $("#f-kgmk").checked,
        retired: $("#f-ret").checked,
        note: $("#f-note").value
    };
}

