$("#slotSearchInput").addEventListener("input", function(e) {
    const q = e.target.value.trim();
    const list = $("#slotResultsList");

    clearTimeout(slotSearchTimeout);

    if (!q) {
        list.innerHTML = `<div style="text-align:center;color:var(--muted);padding:20px;">Введите номер...</div>`;
        return;
    }

    list.innerHTML = `<div style="text-align:center;color:var(--muted);padding:20px;">Поиск...</div>`;

    slotSearchTimeout = setTimeout(() => {
        const normalized = q.toUpperCase().replace(/\s+/g, "");

        const results = DATA
            .filter(d => (d.prefix + d.number).toUpperCase().includes(normalized))
            .slice(0, 50);

        if (!results.length) {
            list.innerHTML = `<div style="text-align:center;color:var(--muted);padding:20px;">Ничего не найдено</div>`;
            return;
        }

        list.innerHTML = results.map(d => {
            const s = stateOf(d.state);
            const currentLoc = d.block ? `${d.block}/${pad2(d.bay)}/T${d.tier}` : "Без координат";
            const isSameSpot = currentSlotTarget &&
                d.block === currentSlotTarget.block &&
                Number(d.bay) === Number(currentSlotTarget.bay) &&
                Number(d.tier) === Number(currentSlotTarget.tier);

            return `<div class="row" style="height:auto;padding:10px;margin-bottom:0;cursor:${isSameSpot ? 'not-allowed' : 'pointer'};opacity:${isSameSpot ? '0.5' : '1'};"
                ${!isSameSpot ? `onclick="moveContainerFromDB(${d.id})"` : ""}>
                <div class="mini" style="--c:${s.color}"></div>
                <div class="id" style="min-width:120px;">
                    <div class="pn">${d.prefix} ${d.number}</div>
                    <div class="ty">${d.typeLegacy || "—"}</div>
                </div>
                <div style="flex:1;font-size:12px;color:var(--muted);">
                    Сейчас: <b style="color:var(--ink-soft)">${currentLoc}</b>
                </div>
                <div style="font-size:12px;color:var(--accent);font-weight:600;">
                    ${isSameSpot ? "Уже здесь" : `→ ${currentSlotTarget.block}/${pad2(currentSlotTarget.bay)}/T${currentSlotTarget.tier}`}
                </div>
            </div>`;
        }).join("");
    }, 150);
});

window.moveContainerFromDB = async function(containerId) {
    if (!currentSlotTarget) return;

    const target = currentSlotTarget;

    try {
        const payload = {
            block: target.block,
            bay: target.bay,
            tier: target.tier
        };

        const res = await fetch(`${API_BASE}/containers/${containerId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (!res.ok) throw new Error("Ошибка сохранения координат");

        let mapped = null;

        try {
            const dataRes = await fetch(`${API_BASE}/containers/${containerId}`);
            if (dataRes.ok) mapped = mapDto(await dataRes.json());
        } catch (e) {
            console.warn("Не удалось получить полные данные контейнера", e);
        }

        const existingIdx = DATA.findIndex(d => d.id === containerId);

        if (mapped) {
            if (existingIdx >= 0) DATA[existingIdx] = mapped;
            else DATA.push(mapped);
        } else if (existingIdx >= 0) {
            DATA[existingIdx].block = target.block;
            DATA[existingIdx].bay = target.bay;
            DATA[existingIdx].tier = target.tier;
        }

        LAYOUT = buildLayoutFromData(DATA);

        closeSlotPicker();

        toast("Контейнер установлен");

        buildFacets();
        render(false);

    } catch (e) {
        console.error(e);
        toast("Ошибка установки контейнера", true);
    }
};

