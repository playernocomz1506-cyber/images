/* ============================================================
   ISO CHECK DIGIT
============================================================ */

const ISO_VAL = {};

(function () {
    let v = 10;
    for (let c = 65; c <= 90; c++) {
        if (v % 11 === 0) v++;
        ISO_VAL[String.fromCharCode(c)] = v++;
    }
})();

function checkDigit(prefix, serial6) {
    const s = (prefix + serial6).toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 10);
    let sum = 0;

    for (let i = 0; i < s.length; i++) {
        const ch = s[i];
        const val = (ch >= "0" && ch <= "9") ? +ch : (ISO_VAL[ch] || 0);
        sum += val * Math.pow(2, i);
    }

    let r = sum % 11;
    if (r === 10) r = 0;
    return r;
}

function computedCheck(it) {
    return checkDigit(it.prefix, String(it.number || "").slice(0, 6));
}

/* ============================================================
   DEMO FALLBACK
============================================================ */

function rnd(a) {
    return a[Math.floor(Math.random() * a.length)];
}

function rndInt(a, b) {
    return a + Math.floor(Math.random() * (b - a + 1));
}

const STATE_POOL = [];
Object.entries({ inuse: 80, damaged: 20 }).forEach(([k, n]) => {
    for (let i = 0; i < n; i++) STATE_POOL.push(k);
});

const PROC_POOL = ["", "arrival", "weighing", "storage", "shipment"];
const H_POOL = [1, 2, 2, 3, 3, 3, 4, 4, 5];

function buildPlan(n) {
    const NAMES = "ABCDEFGHJKLMNPRT";
    const layout = new Map();
    const slots = [];
    let bi = 0;

    while (slots.length < n && bi < NAMES.length + 8) {
        const name = bi < NAMES.length ? NAMES[bi] : ("B" + (bi - NAMES.length + 1));
        const baysCount = 24 + (bi % 5) * 2;
        const bays = [];

        for (let b = 1; b <= baysCount; b++) {
            bays.push(b);
            if (b === baysCount) continue;

            const h = rnd(H_POOL);
            for (let t = 1; t <= h; t++) {
                slots.push({ block: name, bay: b, tier: t });
            }
        }

        layout.set(name, { bays });
        bi++;
    }

    return { slots: slots.slice(0, n), layout };
}

function genData(N) {
    const { slots, layout } = buildPlan(N);
    LAYOUT = layout;

    const out = [];
    let serial = 6180000;
    const DAY = 86400000;
    const now = Date.now();

    const localPrefixes = PREFIXES.length ? PREFIXES : ["NMKU", "TRLU", "MSKU"];
    const localOwners = OWNERS.length ? OWNERS.map(o => o.fullName) : ["Иванов А.С.", "Петров В.И."];

    for (let i = 0; i < N; i++) {
        const prefix = rnd(localPrefixes);
        const typeLegacy = rnd(DEMO_TYPES);
        const pw = typeAttrs(typeLegacy).pw;
        const state = rnd(STATE_POOL);

        serial += 1 + Math.floor(Math.random() * 7);
        const s6 = String(serial).slice(-6);
        const cd = checkDigit(prefix, s6);
        const valid = Math.random() > 0.08;
        const last = valid ? cd : ((cd + 1 + Math.floor(Math.random() * 8)) % 10);
        const number = s6 + last;

        const proc = rnd(PROC_POOL);
        const createdAt = now - rndInt(30, 420) * DAY;

        let tareFact = null;
        let gross = null;
        let grossRepeat = null;

        if (proc === "weighing") {
            if (Math.random() < 0.5) tareFact = pw + rndInt(-30, 30);
        } else if (proc !== "") {
            tareFact = pw + rndInt(-30, 30);
        }

        if (proc === "storage" || proc === "shipment") {
            if (tareFact == null) tareFact = pw + rndInt(-30, 30);
            gross = tareFact + rndInt(5000, 21000);
            if (Math.random() < 0.5) grossRepeat = gross + rndInt(-45, 45);
        }

        out.push({
            id: i + 1,
            prefix,
            number,
            iso: "",
            typeLegacy,
            pw,
            tareFact,
            gross,
            grossRepeat,
            state,
            procState: proc,
            owner: rnd(localOwners),
            kgmk: Math.random() > 0.4,
            retired: false,
            block: slots[i]?.block || null,
            bay: slots[i]?.bay || null,
            tier: slots[i]?.tier || null,
            docs: [],
            moveLog: [],
            changeLog: [],
            createdAt,
            updatedAt: createdAt,
            note: ""
        });
    }

    return out;
}

/* ============================================================
