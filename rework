function groupBlocks() {
    const blocks = new Map();

    for (const d of DATA) {
        if (!d.block || d.bay == null || d.tier == null) continue;

        const block = d.block;
        const bay = Number(d.bay);

        if (!blocks.has(block)) blocks.set(block, new Map());

        const b = blocks.get(block);

        if (!b.has(bay)) b.set(bay, []);

        b.get(bay).push(d);
    }

    return blocks;
}

function renderStacks() {
    const idx = groupBlocks();
    const blockNames = [...idx.keys()].sort((a, b) => a.localeCompare(b, "ru"));

    yard.innerHTML =
        `<div class="yard-stacks">` +
        blockNames.map(name => renderOneBlock(name, idx)).join("") +
        `</div>`;

    updateStackHighlights();
}
