function renderMoves(log) {
    if (!log || !log.length) {
        return `<div class="mv-empty">Перемещений не зафиксировано</div>`;
    }

    return log.slice().sort((a, b) => b.at - a.at).map(m =>
        `<div class="mv">
            <span class="mv-time">${fmtDate(m.at)}</span>
            <span class="mv-route">
                ${m.from.block}/${pad2(m.from.bay)}/T${m.from.tier}
                <span class="arr">→</span>
                ${m.to.block}/${pad2(m.to.bay)}/T${m.to.tier}
