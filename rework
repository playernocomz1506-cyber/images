function setTab(tab) {
    drawerTab = tab;

    $("#drTabs").querySelectorAll("button").forEach(b => {
        b.classList.toggle("on", b.dataset.tab === tab);
    });

    document.querySelectorAll(".tab-pane").forEach(p => {
