function buildLayoutFromData(dataList) {
    const layoutMap = new Map();

    dataList.forEach(d => {
        if (!d.block) return;

        if (!layoutMap.has(d.block)) {
            layoutMap.set(d.block, { bays: new Set() });
        }

        if (d.bay != null) {
            layoutMap.get(d.block).bays.add(Number(d.bay));
        }
    });

    return layoutMap;
}

async function loadDictionaries() {
    try {
        const [ownersRes, prefixesRes, statesRes, typesRes] = await Promise.all([
            fetch(`${API_BASE}/dictionaries/owners`),
            fetch(`${API_BASE}/dictionaries/prefixes`),
            fetch(`${API_BASE}/dictionaries/states`),
            fetch(`${API_BASE}/dictionaries/types`)
        ]);

        if (ownersRes.ok) {
            OWNERS = await ownersRes.json();

            const ownerSelect = $("#f-owner");
            const bulkOwnerSelect = $("#bb-owner");

            const optionsHtml = OWNERS
                .map(o => `<option value="${o.fullName}">${o.fullName}</option>`)
                .join("");

            if (ownerSelect) {
                ownerSelect.innerHTML = `<option value="">Не назначен</option>` + optionsHtml;
            }

            if (bulkOwnerSelect) {
                bulkOwnerSelect.innerHTML = `<option value="">— не менять —</option>` + optionsHtml;
            }
        }

        if (prefixesRes.ok) {
            const prefixesJson = await prefixesRes.json();
            PREFIXES = prefixesJson.map(p => p.prefix).filter(Boolean);
        }

        if (statesRes.ok) {
            const statesJson = await statesRes.json();

            statesJson.forEach(s => {
                if (!s.code) return;

                STATES[s.code] = {
                    name: s.name || s.code,
                    color: s.colorHex || STATES[s.code]?.color || "#888",
                    hex: s.colorHex || STATES[s.code]?.hex || "#888",
                    pulse: !!s.pulse
                };
            });
        }

        if (typesRes.ok) {
            const typesJson = await typesRes.json();

            window.CONTAINER_TYPES = typesJson.filter(t => !isJunkType(t.caption));
            ALL_TYPES = window.CONTAINER_TYPES.map(t => t.caption).filter(Boolean);
        } else {
            window.CONTAINER_TYPES = DEMO_TYPES.map(caption => ({ caption }));
            ALL_TYPES = [...DEMO_TYPES];
        }

    } catch (e) {
        console.warn("Не удалось загрузить справочники, используем дефолтные", e);

        window.CONTAINER_TYPES = DEMO_TYPES.map(caption => ({ caption }));
        ALL_TYPES = [...DEMO_TYPES];
    }
}

async function fetchAllContainers() {
    const out = [];
    let page = 0;
    const size = pagination.chunkSize;

    while (true) {
        const params = new URLSearchParams({
            page: String(page),
            size: String(size)
        });

        const res = await fetch(`${API_BASE}/containers?${params.toString()}`);
        if (!res.ok) throw new Error("Ошибка загрузки контейнеров");

        const chunk = await res.json();
        if (!Array.isArray(chunk)) throw new Error("API вернул не массив контейнеров");

        out.push(...chunk);

        if (chunk.length < size) break;

        page++;

        if (page > 1000) break;
    }

    return out;
}

async function loadData() {
    pagination.isLoading = true;

    try {
        await loadDictionaries();

        DATA = [];
        LAYOUT = new Map();

        const arr = await fetchAllContainers();

        DATA = arr.map(mapDto);
        dataSource = "db";

        pagination.totalElements = DATA.length;
        pagination.hasMore = false;

        LAYOUT = buildLayoutFromData(DATA);

        DATA.forEach(d => {
            d.docs = d.docs || [];
            d.moveLog = d.moveLog || [];
            d.changeLog = d.changeLog || [];
