$("#viewSeg").querySelectorAll("button").forEach(b => b.onclick = () => {
    if (drag) cleanupDrag();

    if (marquee) {
        if (marquee.el) marquee.el.remove();
        marquee = null;
    }

    clearSelection();

    view = b.dataset.view;

    $("#viewSeg").querySelectorAll("button").forEach(x => {
        x.classList.toggle("on", x === b);
    });

    render(true);
});
