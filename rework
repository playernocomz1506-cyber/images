============================================================ */

function toMillis(v) {
    if (v == null || v === "") return null;
    if (typeof v === "number") return v;
    const t = new Date(v).getTime();
    return Number.isFinite(t) ? t : null;
}

function mapMoveDto(m) {
    if (!m) return null;

    if (m.from && m.to) {
        return {
            at: toMillis(m.at) || Date.now(),
            from: m.from,
            to: m.to
        };
    }

    return {
        at: toMillis(m.at || m.movedAt) || Date.now(),
        from: {
            block: m.fromBlock,
            bay: m.fromBay,
            tier: m.fromTier
        },
        to: {
            block: m.toBlock,
            bay: m.toBay,
            tier: m.toTier
        }
    };
}

function mapDocDto(d) {
    return {
        id: d.id,
        type: d.type,
        num: d.num,
        date: toMillis(d.date),
        carrier: d.carrier
    };
}

function mapChangeDto(l) {
    return {
        id: l.id,
        at: toMillis(l.at) || Date.now(),
        user: l.user || CURRENT_USER,
        field: l.field,
        from: l.from,
        to: l.to
    };
}

function mapDto(x) {
    const rawNumber = String(x.numContainer ?? "").replace(/\D/g, "");

    const serial6 = rawNumber.length >= 7
        ? rawNumber.slice(0, 6)
        : rawNumber.padStart(6, "0").slice(-6);

    const checkDigitFromDto = x.checkDigit != null
        ? String(x.checkDigit)
        : (rawNumber.length >= 7 ? rawNumber.slice(6, 7) : "");

    const number = (serial6 + checkDigitFromDto).padEnd(7, "0");

    const retired = x.isRetired != null
        ? !!x.isRetired
        : (x.isUnretired != null ? !x.isUnretired : false);

    return {
        id: x.id,
        prefix: x.prefix || x.prefixName || "",
        number,

        typeId: x.typeId ?? null,
        typeLegacy: x.typeCaption || x.typeLegacy || "",
        iso: x.isoCode || x.isoTypeCode || "",

        pw: x.tareStencilKg != null ? Math.round(Number(x.tareStencilKg)) : null,
        tareFact: x.tareFactKg != null ? Math.round(Number(x.tareFactKg)) : null,
        gross: x.grossKg != null ? Math.round(Number(x.grossKg)) : null,
        grossRepeat: x.grossRepeatKg != null ? Math.round(Number(x.grossRepeatKg)) : null,

        state: x.state || "inuse",
        procState: x.procState || "",

        owner: x.responsible || "Не назначен",
        kgmk: !!x.isKgmk,
        retired,

        block: x.block || null,
        bay: x.bay != null ? Number(x.bay) : null,
        tier: x.tier != null ? Number(x.tier) : null,

        docs: (x.docs || []).map(mapDocDto),
        moveLog: (x.moveLog || []).map(mapMoveDto).filter(Boolean),
        changeLog: (x.changeLog || []).map(mapChangeDto),

        createdAt: toMillis(x.createdAt) || Date.now(),
        updatedAt: toMillis(x.updatedAt) || Date.now(),

        note: x.notes || ""
    };
}

