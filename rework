        entries.forEach(([val, name, count, color]) => {
            f.insertAdjacentHTML(
                "beforeend",
                chipHTML(id.split("-")[1], val, name, count, color, hasDot)
            );
        });
    };

    fill("#facet-state", [
        [
            "inuse",
            STATES.inuse?.name || "Удовлетворительное",
            DATA.filter(d => d.state === "inuse").length,
            STATES.inuse?.hex || "#2f6b4f"
        ],
        [
            "damaged",
            STATES.damaged?.name || "Брак",
            DATA.filter(d => d.state === "damaged").length,
            STATES.damaged?.hex || "#9c3b22"
        ]
    ], true);

    const procEntries = [
        [
            "__none",
            "не в операции",
            DATA.filter(d => !d.procState).length,
            "#9aa7b4"
        ]
    ];

    Object.entries(PROC).forEach(([code, p]) => {
        procEntries.push([
            code,
            p.name,
            DATA.filter(d => d.procState === code).length,
            p.hex
        ]);
    });

    fill("#facet-proc", procEntries, true);

    const typeCounts = new Map();

    (window.CONTAINER_TYPES || []).forEach(t => {
        if (!t.caption || isJunkType(t.caption)) return;
        typeCounts.set(t.caption, 0);
    });

    DATA.forEach(d => {
        const cap = d.typeLegacy || "—";
        if (isJunkType(cap)) return;
        typeCounts.set(cap, (typeCounts.get(cap) || 0) + 1);
    });

    const typeEntries = Array.from(typeCounts.entries())
        .sort((a, b) => a[0].localeCompare(b[0], "ru"))
        .map(([cap, count]) => [cap, cap, count, null]);

    fill("#facet-type", typeEntries, false);

    fill("#facet-own", [
        [
            "kgmk",
            "Собственность КГМК",
            DATA.filter(d => d.kgmk).length,
            "var(--accent)"
        ],
        [
            "other",
            "Прочие / аренда",
            DATA.filter(d => !d.kgmk).length,
            "#8593a1"
        ]
    ], false);

    document.querySelectorAll(".chip").forEach(c => {
        const set = filters[c.dataset.facet];
        if (!set) return;

        if (set.has(c.dataset.val)) {
            c.classList.add("active");
        }

        c.onclick = () => {
            if (set.has(c.dataset.val)) set.delete(c.dataset.val);
            else set.add(c.dataset.val);

            c.classList.toggle("active");
            applyChange(true);
        };
    });
}

function getFiltered() {
    let arr = DATA.filter(d => {
        if (filters.state.size && !filters.state.has(d.state)) return false;

        if (filters.proc.size) {
            const v = d.procState || "__none";
            if (!filters.proc.has(v)) return false;
        }

        if (filters.type.size && !filters.type.has(d.typeLegacy || "—")) return false;

        if (filters.own.size && !filters.own.has(d.kgmk ? "kgmk" : "other")) return false;

        if (query) {
            const q = query.toUpperCase().replace(/\s+/g, "");
            if (!(d.prefix + d.number).toUpperCase().includes(q)) return false;
        }

        return true;
    });

    if (sort === "num") {
        arr.sort((a, b) => (a.prefix + a.number).localeCompare(b.prefix + b.number));
    }

    if (sort === "state") {
        arr.sort((a, b) => a.state.localeCompare(b.state) || (a.prefix + a.number).localeCompare(b.prefix + b.number));
    }

    if (sort === "proc") {
        arr.sort((a, b) => (a.procState || "").localeCompare(b.procState || "") || (a.prefix + a.number).localeCompare(b.prefix + b.number));
    }

    if (sort === "weight") {
        arr.sort((a, b) => (b.gross || 0) - (a.gross || 0));
    }

    return arr;
}

function animateNumber(el, to) {
    if (!el) return;

    to = Number(to) || 0;

    const from = +(el.dataset.v || 0);
    el.dataset.v = to;

    if (from === to) {
        el.textContent = fmt(to);
        return;
    }

    const t0 = performance.now();
    const dur = 420;

    (function step(t) {
        const k = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - k, 3);

        el.textContent = fmt(Math.round(from + (to - from) * e));

        if (k < 1) requestAnimationFrame(step);
    })(t0);
}

function updateTopCounters() {
    animateNumber($("#cnt-inuse"), DATA.filter(d => d.state === "inuse").length);
    animateNumber($("#cnt-alert"), DATA.filter(d => isProblem(d)).length);

    animateNumber($("#cnt-a"), DATA.filter(d => d.procState === "arrival").length);
    animateNumber($("#cnt-w"), DATA.filter(d => d.procState === "weighing").length);
    animateNumber($("#cnt-s"), DATA.filter(d => d.procState === "storage").length);
    animateNumber($("#cnt-h"), DATA.filter(d => d.procState === "shipment").length);
}

/* ============================================================
   ВИРТУАЛИЗАЦИЯ И РЕНДЕР
============================================================ */

function makeVirtual(outer, { rowH, columns, items, buildItem, mode, fresh }) {
    outer.innerHTML = "";

    const inner = document.createElement("div");
    inner.className = "vroot";
    outer.appendChild(inner);

    const win = document.createElement("div");
    win.className = "vwindow" + (fresh ? " fresh" : "");

    if (mode === "grid") {
        win.style.display = "grid";
        win.style.gridTemplateColumns = `repeat(${columns},minmax(0,1fr))`;
        win.style.gridAutoRows = rowH + "px";
        win.style.columnGap = "18px";
        win.style.alignItems = "start";
    } else {
        win.style.display = "flex";
        win.style.flexDirection = "column";
    }

    inner.appendChild(win);

    const state = { columns, rowH, mode };

    const rowCount = () => mode === "grid"
        ? Math.max(1, Math.ceil(items.length / state.columns))
        : items.length;

    const setInnerH = () => {
        inner.style.height = (rowCount() * rowH) + "px";
    };

    setInnerH();

    function paint() {
        const viewH = outer.clientHeight || 600;
        const firstRow = Math.max(0, Math.floor(outer.scrollTop / rowH) - OVER);
        const lastRow = Math.min(rowCount() - 1, Math.floor((outer.scrollTop + viewH - 1) / rowH) + OVER);

        const a = mode === "grid" ? firstRow * state.columns : firstRow;
        const b = mode === "grid"
            ? Math.min(items.length, (lastRow + 1) * state.columns)
            : (lastRow + 1);

        let html = "";

        for (let i = a; i < b; i++) {
            html += buildItem(items[i]);
        }

        win.innerHTML = html;
        win.style.top = (firstRow * rowH) + "px";

        win.querySelectorAll("[data-id]").forEach(n => {
            if (n.classList.contains("gbox")) return;
            n.onclick = () => openDrawer(+n.dataset.id);
        });
    }

    let raf = 0;

    outer.onscroll = () => {
        if (!raf) {
            raf = requestAnimationFrame(() => {
                raf = 0;
                paint();
            });
        }
    };

    outer._v = {
        paint,
        refreshCols(nc) {
            if (mode === "grid" && nc && nc !== state.columns) {
                state.columns = nc;
                win.style.gridTemplateColumns = `repeat(${nc},minmax(0,1fr))`;
                setInnerH();
            }

            paint();
        }
    };

    paint();
}

function yardCols() {
    const w = yard.clientWidth - 48;
    return Math.max(1, Math.floor((w + 18) / (MINCOL + 18)));
