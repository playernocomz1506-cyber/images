function renderGroups(arr, fresh) {
    const order = ["damaged", "inuse"];
    const scrollPositions = {};

    if (!fresh) {
        yard.querySelectorAll(".gcol-scroll").forEach(sc => {
            scrollPositions[sc.dataset.state] = sc.scrollTop;
        });
    }

    if (fresh || !yard.querySelector(".groups")) {
        yard.innerHTML = `<div class="groups">` + order.map(k => {
            const s = stateOf(k);

            return `<div class="gcol" data-group-state="${k}">
                <div class="gh">
                    <span class="d" style="background:${s.color}"></span>
                    <span class="t">${s.name}</span>
                    <span class="n" id="grp-cnt-${k}">0</span>
                </div>
                <div class="gcol-scroll" data-state="${k}"></div>
            </div>`;
        }).join("") + `</div>`;

        setupGroupDropZones();
    }

    yard.querySelectorAll(".gcol-scroll").forEach(sc => {
        const k = sc.dataset.state;
        const items = arr.filter(d => d.state === k);
        const cntEl = $(`#grp-cnt-${k}`);

        if (cntEl) cntEl.textContent = fmt(items.length);

        if (!items.length) {
            sc.innerHTML = `<div style="font-size:12px;color:var(--muted);padding:8px 6px;text-align:center">пусто</div>`;
            return;
        }

        makeVirtual(sc, {
            rowH: ROWH.g,
            columns: 1,
            items,
            buildItem: gboxHTMLInteractive,
            mode: "col",
            fresh
        });

        if (!fresh && scrollPositions[k] !== undefined) {
            sc.scrollTop = scrollPositions[k];
        }
    });
}

function gboxHTMLInteractive(d) {
    const isSel = selectedIds.has(d.id);
    const s = stateOf(d.state);

    return `<div class="gbox ${isSel ? 'bulk-sel' : ''} ${d.id === selectedId ? 'sel' : ''}"
        style="--c:${s.color}"
        data-id="${d.id}"
        draggable="${canWrite() ? 'true' : 'false'}"
        ondragstart="onGroupDragStart(event, ${d.id})"
        onclick="toggleGroupSelection(event, ${d.id})">
        <div class="pn">${d.prefix} ${d.number}</div>
        <div class="sub">
            <span>${typeLabel(d)}</span>
            <span>${fmt(dispWeight(d))} кг</span>
        </div>
    </div>`;
}

let draggedGroupId = null;

window.onGroupDragStart = function(e, id) {
    if (!canWrite()) {
        e.preventDefault();
        return;
    }

    draggedGroupId = id;
    e.dataTransfer.effectAllowed = "move";

    setTimeout(() => e.target.classList.add("dragging"), 0);
};

window.toggleGroupSelection = function(e, id) {
    if (e.defaultPrevented) return;

    if (selectedIds.has(id)) selectedIds.delete(id);
    else selectedIds.add(id);

    renderGroups(getFiltered(), false);
    syncBulkUI();
};

function setupGroupDropZones() {
    document.querySelectorAll(".gcol").forEach(col => {
        col.addEventListener("dragover", e => {
            e.preventDefault();
            e.dataTransfer.dropEffect = "move";
            col.classList.add("drag-over");
        });

        col.addEventListener("dragleave", () => {
            col.classList.remove("drag-over");
        });

        col.addEventListener("drop", e => {
            e.preventDefault();
            col.classList.remove("drag-over");

            const newState = col.dataset.groupState;

            if (draggedGroupId && newState) {
                moveContainerToGroup(draggedGroupId, newState);
            }

            draggedGroupId = null;
        });
    });
}

async function moveContainerToGroup(id, newState) {
    const container = DATA.find(d => d.id === id);
    if (!container || container.state === newState) return;

    const oldState = container.state;
    container.state = newState;

    renderGroups(getFiltered(), false);
    buildFacets();
    updateTopCounters();

    toast(`Контейнер ${container.prefix} ${container.number} → ${stateOf(newState).name}`);

    if (dataSource === "db") {
        try {
            const res = await fetch(`${API_BASE}/containers/${id}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ state: newState })
            });

            if (!res.ok) throw new Error("Failed to update state");

            buildFacets();
            updateTopCounters();

        } catch (e) {
            console.error(e);

            container.state = oldState;
            renderGroups(getFiltered(), false);
            buildFacets();
            updateTopCounters();

            toast("Ошибка обновления состояния", true);
        }
    }
}

/* ============================================================
   ШТАБЕЛИ
============================================================ */

function groupBlocks() {
    const blocks = new Map();

    for (const d of DATA) {
        if (!d.block || d.bay == null || d.tier == null) continue;

        const block = d.block;
        const bay = Number(d.bay);

        if (!blocks.has(block)) blocks.set(block, new Map());

        const b = blocks.get(block);

        if (!b.has(bay)) b.set(bay, []);

        b.get(bay).push(d);
    }

    return blocks;
}

function renderOneBlock(name, idxAll = null) {
    const lay = LAYOUT.get(name);
    const idx = (idxAll || groupBlocks()).get(name) || new Map();

    const knownBays = new Set();

    if (lay && lay.bays) {
        const source = lay.bays instanceof Set ? lay.bays : new Set(lay.bays);
        source.forEach(x => knownBays.add(Number(x)));
    }

    idx.forEach((_, bay) => knownBays.add(Number(bay)));

    let bays = Array.from(knownBays).sort((a, b) => a - b);

    const MIN_BAYS = 20;
    const maxBay = Math.max(MIN_BAYS, 0, ...bays);

    bays = [];
    for (let i = 1; i <= maxBay; i++) bays.push(i);

    let maxTier = 0;
    let totalTiers = 0;

    const piles = bays.map(bn => {
        const items = (idx.get(bn) || []).slice().sort((a, b) => a.tier - b.tier);
        const h = items.length ? Math.max(...items.map(i => Number(i.tier))) : 0;

        if (h > maxTier) maxTier = h;
        totalTiers += items.length;

        const layers = items.map(d => {
            const buried = h - Number(d.tier);
            const bottomPos = (Number(d.tier) - 1) * TSTEP;
            const s = stateOf(d.state);

            return `<div class="tier ${d.id === selectedId ? 'sel' : ''} ${selectedIds.has(d.id) ? 'msel' : ''}"
                style="--c:${s.color}; bottom:${bottomPos}px"
                data-id="${d.id}"
                title="${d.prefix} ${d.number} · ярус ${d.tier}${buried > 0 ? ` · снять ${buried} сверху` : ""}">
                <span class="tn">${String(d.number || "").slice(2, 6)}</span>
                ${buried > 0 ? `<span class="buried">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12l7 7 7-7"/></svg>${buried}
                </span>` : ""}
            </div>`;
        }).join("");

        let emptySlotsHtml = "";
        const targetTier = h === 0 ? 1 : h + 1;

        if (targetTier <= HARD_MAX) {
            const bottomPos = (targetTier - 1) * TSTEP;

            emptySlotsHtml = `<div class="empty-slot"
                style="bottom:${bottomPos}px"
                onclick="openSlotPicker('${name}', ${bn}, ${targetTier})"
                title="Найти контейнер в БД и поставить сюда">
                + T${targetTier}
            </div>`;
        }

        const pileH = Math.max(1, HARD_MAX) * TSTEP;

        return `<div class="stack-col" data-block="${name}" data-bay="${bn}">
            <div class="pile" style="height:${pileH}px">${layers}${emptySlotsHtml}</div>
            <div class="bay-no">${pad2(bn)}</div>
        </div>`;
    }).join("");

    const axH = Math.max(1, maxTier + 1);

    const axis = Array.from({ length: axH }, (_, i) => axH - i)
        .map(t => `<span class="ta-m" style="bottom:${(t - 1) * TSTEP}px">T${t}</span>`)
        .join("");

    const cap = bays.length * HARD_MAX;
    const load = cap ? Math.round(totalTiers / cap * 100) : 0;

    return `<div class="stack-block" data-block="${name}">
        <div class="sb-head">
            <div class="sb-title"><span class="blk">${name}</span>Секция ${name}</div>
            <div class="sb-meta">${bays.length} рядов · ${totalTiers} ярусов · лимит ≤${HARD_MAX}</div>
            <div class="sb-load">загрузка <div class="bar"><i style="width:${load}%"></i></div>${load}%</div>
        </div>
        <div class="sb-body">
            <div class="tier-axis" style="height:${axH * TSTEP}px">${axis}</div>
            <div class="sb-row" style="height:${axH * TSTEP + 32}px">${piles}</div>
        </div>
    </div>`;
}

function renderStacks() {
    const idx = groupBlocks();
    const blockNames = [...idx.keys()].sort((a, b) => a.localeCompare(b, "ru"));

    yard.innerHTML = `<div class="yard-stacks">` +
        blockNames.map(name => renderOneBlock(name, idx)).join("") +
        `</div>`;

    updateStackHighlights();
}

let lastAimId = null;

function updateStackHighlights() {
    if (view !== "stacks") return;

    const on = anyFilterActive();
    const matched = on ? new Set(getFiltered().map(d => d.id)) : null;

    yard.querySelectorAll(".tier").forEach(t => {
        if (!on) {
            t.classList.remove("hit", "dim");
        } else {
            const m = matched.has(+t.dataset.id);
            t.classList.toggle("hit", m);
            t.classList.toggle("dim", !m);
        }
    });

    yard.querySelectorAll(".stack-block").forEach(bl => {
        const rows = bl.querySelectorAll(".stack-col").length;
        const total = bl.querySelectorAll(".tier").length;
        const found = on ? bl.querySelectorAll(".tier.hit").length : total;

        const meta = bl.querySelector(".sb-meta");
        if (meta) {
            meta.textContent = on
                ? `${rows} рядов · найдено ${found} · лимит ≤${HARD_MAX}`
                : `${rows} рядов · ${total} ярусов · лимит ≤${HARD_MAX}`;
        }

        bl.classList.toggle("has-hit", on && found > 0);
    });

    const placedCount = DATA.filter(d => d.block && d.bay != null && d.tier != null).length;
    $("#shown").textContent = fmt(on ? matched.size : placedCount);

    if (on && matched && matched.size >= 1 && matched.size <= 12) {
        const first = [...matched][0];

        if (first !== lastAimId) {
            lastAimId = first;

            const el = yard.querySelector('.tier[data-id="' + first + '"]');

            if (el) {
                const blk = el.closest(".stack-block");
                if (blk) blk.scrollIntoView({ block: "center", behavior: "smooth" });

                el.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
                el.classList.remove("search-ring");
                void el.offsetWidth;
                el.classList.add("search-ring");

                setTimeout(() => el.classList.remove("search-ring"), 1500);
            }
        }
    } else {
        lastAimId = null;
    }
}

/* ============================================================
   ВЫДЕЛЕНИЕ, BULK, UNDO
============================================================ */

function clearSelection() {
    if (!selectedIds.size) {
        syncBulkUI();
        return;
    }

    selectedIds.clear();

    yard.querySelectorAll(".tier.msel,.tier.marquee-sel,.gbox.bulk-sel").forEach(t => {
        t.classList.remove("msel", "marquee-sel", "bulk-sel");
    });

    syncBulkUI();
}

function syncBulkUI() {
    const showBulk = (view === "stacks" || view === "groups") && selectedIds.size > 0;

    $("#bulkBar").classList.toggle("show", showBulk);
    $("#bb-n").textContent = selectedIds.size;
    $("#bb-apply").disabled = !canWrite();

    const n = actUndo().length;
    const r = actRedo().length;
    const ub = $("#undoBtn");
    const rb = $("#redoBtn");
    const writeOK = canWrite();

    ub.classList.toggle("disabled", n === 0 || !writeOK);
    ub.disabled = n === 0 || !writeOK;

    rb.classList.toggle("disabled", r === 0 || !writeOK);
    rb.disabled = r === 0 || !writeOK;

    const badge = $("#undoBadge");
    badge.textContent = n;
    badge.style.display = n > 0 ? "flex" : "none";

    if (n !== prevUndoLen) {
        badge.classList.remove("bump");
        void badge.offsetWidth;
        badge.classList.add("bump");
        prevUndoLen = n;
    }

    $("#undoRail").classList.toggle("has", view === "stacks" && n > 0);

    buildRail();
}

function buildRail() {
    const track = $("#urTrack");
    if (!track) return;

    track.querySelectorAll(".ur-tick,.ur-now").forEach(e => e.remove());

    const stack = actUndo();

    stack.forEach((s, i) => {
        const t = document.createElement("div");
        t.className = "ur-tick";
        t.innerHTML = `<span class="dot"></span><span class="lb">${s.label || ("шаг " + (i + 1))}</span>`;
        t.title = (s.at ? fmtDate(s.at) + " · " : "") + (s.label || "");

        t.onclick = () => {
            if (!canWrite()) return;

            const steps = stack.length - i;
            for (let k = 0; k < steps; k++) undoOne();

            toast("Откат к шагу: " + (s.label || ("№" + (i + 1))));
            updateStackHighlights();
            syncBulkUI();
        };

        track.appendChild(t);
    });

    const now = document.createElement("div");
    now.className = "ur-now";
    now.innerHTML = `<span class="dot"></span><span class="lb">сейчас</span>`;
    track.appendChild(now);

    track.scrollLeft = track.scrollWidth;
}

function flipBlocksAfterApply(blocksSet, snapCoords) {
    const oldMap = new Map();
    snapCoords.forEach(c => oldMap.set(c.id, { x: c._x, y: c._y }));

    const idx = groupBlocks();

    blocksSet.forEach(bn => {
        const el = yard.querySelector('.stack-block[data-block="' + bn + '"]');
        if (el) el.outerHTML = renderOneBlock(bn, idx);
    });

    blocksSet.forEach(bn => {
        const bl = yard.querySelector('.stack-block[data-block="' + bn + '"]');
        if (!bl) return;

        bl.querySelectorAll(".tier").forEach(t => {
            const id = +t.dataset.id;
            const o = oldMap.get(id);
            if (!o || o.x == null) return;

            const r = t.getBoundingClientRect();
            const dx = o.x - r.left;
            const dy = o.y - r.top;

            if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;

            t.style.transition = "none";
            t.style.transform = `translate(${dx}px,${dy}px)`;

            requestAnimationFrame(() => {
                t.style.transition = "transform .44s cubic-bezier(.2,.85,.25,1)";
                t.style.transform = "";
            });

            setTimeout(() => {
                t.style.transition = "";
                t.style.transform = "";
            }, 460);
        });
    });
}

function stampRects(snap) {
    snap.coords.forEach(c => {
        const el = yard.querySelector('.tier[data-id="' + c.id + '"]');

        if (el) {
            const r = el.getBoundingClientRect();
            c._x = r.left;
            c._y = r.top;
        } else {
            c._x = null;
            c._y = null;
        }
    });
}

function applySnapshot(snap, toStack) {
    const reverse = { coords: [], logLens: [], label: snap.label, at: snap.at };
    const blocksSet = new Set();

    snap.coords.forEach(c => {
        const d = DATA.find(x => x.id === c.id);
        if (!d) return;

        reverse.coords.push({
            id: c.id,
            block: d.block,
            bay: d.bay,
            tier: d.tier,
            _x: c._x,
            _y: c._y
        });

        blocksSet.add(c.block);
    });

    snap.logLens.forEach(l => {
        const d = DATA.find(x => x.id === l.id);
        if (d) reverse.logLens.push({ id: l.id, len: (d.moveLog || []).length });
    });

    snap.coords.forEach(c => {
        const d = DATA.find(x => x.id === c.id);
        if (d) {
            d.block = c.block;
            d.bay = c.bay;
            d.tier = c.tier;
        }
    });

    snap.logLens.forEach(l => {
        const d = DATA.find(x => x.id === l.id);
        if (d) d.moveLog = (d.moveLog || []).slice(0, l.len);
    });

    toStack.push(reverse);
    if (toStack.length > STACK_CAP) toStack.shift();

    LAYOUT = buildLayoutFromData(DATA);
    flipBlocksAfterApply(blocksSet, snap.coords);
}

function undoOne() {
    const s = actUndo().pop();
    if (!s) return;
    applySnapshot(s, actRedo());
    return s;
}

function redoOne() {
    const s = actRedo().pop();
    if (!s) return;
    applySnapshot(s, actUndo());
    return s;
}

function undoLastMove() {
    if (!canWrite()) return;

    const s = undoOne();
    if (!s) return;

    toast("Движение отменено" + (s.label ? ": " + s.label : ""));
    updateStackHighlights();
    syncBulkUI();
}

function redoLastMove() {
    if (!canWrite()) return;

    const s = redoOne();
    if (!s) return;

    toast("Движение повторено" + (s.label ? ": " + s.label : ""));
    updateStackHighlights();
    syncBulkUI();
}

function performMove(removedIds, dstBlock, dstBay, label) {
    const bySrc = new Map();

    removedIds.forEach(id => {
        const d = DATA.find(x => x.id === id);
        if (!d) return;

        const k = d.block + "|" + d.bay;

        if (!bySrc.has(k)) {
            bySrc.set(k, { block: d.block, bay: d.bay, min: d.tier });
        } else {
            bySrc.get(k).min = Math.min(bySrc.get(k).min, d.tier);
        }
    });

    const snap = { coords: [], logLens: [], label, at: Date.now() };

    bySrc.forEach(({ block, bay, min }) => {
        DATA.forEach(d => {
            if (d.block === block && Number(d.bay) === Number(bay) && d.tier >= min) {
                snap.coords.push({ id: d.id, block: d.block, bay: d.bay, tier: d.tier });
            }
        });
    });

    removedIds.forEach(id => {
        const d = DATA.find(x => x.id === id);
        if (d) snap.logLens.push({ id: d.id, len: (d.moveLog || []).length });
    });

    stampRects(snap);

    actUndo().push(snap);
    if (actUndo().length > STACK_CAP) actUndo().shift();

    actRedo().length = 0;

    const order = removedIds
        .map(id => DATA.find(x => x.id === id))
        .filter(Boolean)
        .sort((a, b) => (a.block + a.bay).localeCompare(b.block + b.bay) || a.tier - b.tier);

    let h = topTier(dstBlock, dstBay);

    order.forEach(d => {
        h++;

        const from = { block: d.block, bay: d.bay, tier: d.tier };

        d.block = dstBlock;
        d.bay = dstBay;
        d.tier = h;

        d.moveLog = d.moveLog || [];
        d.moveLog.push({
            at: Date.now(),
            from,
            to: { block: dstBlock, bay: dstBay, tier: h }
        });
    });

    bySrc.forEach(({ block, bay }) => compactStack(block, bay));

    LAYOUT = buildLayoutFromData(DATA);

    const blocksSet = new Set([...bySrc.values()].map(v => v.block));
    blocksSet.add(dstBlock);

    flipBlocksAfterApply(blocksSet, snap.coords);

    if (dataSource === "db") {
        const movesPayload = removedIds.map(id => {
            const d = DATA.find(x => x.id === id);
            return d ? { id: d.id, block: d.block, bay: d.bay, tier: d.tier } : null;
        }).filter(Boolean);

        const url = planMode
            ? `${API_BASE}/containers/plans/move`
            : `${API_BASE}/containers/move`;

        fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(movesPayload)
        }).then(res => {
            if (!res.ok) throw new Error("Network error");

            if (planMode) {
                movesPayload.forEach(m => {
                    PLAN_DATA.set(m.id, { block: m.block, bay: m.bay, tier: m.tier });
                });
            }
        }).catch(err => {
            console.error("Ошибка синхронизации", err);
            toast("Ошибка сохранения перемещения", true);
        });
    }
}

/* ============================================================
   DRAG & DROP ШТАБЕЛЕЙ
============================================================ */

let drag = null;
const DRAG_THRESHOLD = 4;

const NO_SVG = `<svg class="dg-no" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="10" fill="#fff" stroke="#b23a22" stroke-width="2.4"/>
    <line x1="5" y1="5" x2="19" y2="19" stroke="#b23a22" stroke-width="2.4" stroke-linecap="round"/>
</svg>`;

function removedAboveFor(id) {
    const d = DATA.find(x => x.id === id);
    if (!d) return 0;
    return topTier(d.block, d.bay) - d.tier;
}

function onTierPointerDown(e) {
    if (view !== "stacks" || e.button !== 0) return;
    if (!canWrite()) return;

    const t = e.target.closest(".tier");
    if (!t || !yard.contains(t)) return;
    if ($("#drawer").classList.contains("open")) return;

    const id = +t.dataset.id;
    const d = DATA.find(x => x.id === id);
    if (!d) return;

    const group = selectedIds.size > 1 && selectedIds.has(id);

    drag = {
        id,
        group,
        groupIds: group ? [...selectedIds] : [id],
        fromBlock: d.block,
        fromBay: d.bay,
        fromTier: d.tier,
        movedName: typeLabel(d),
        tierEl: t,
        startX: e.clientX,
        startY: e.clientY,
        active: false,
        curCol: null,
        slot: null,
        _pile: null,
        _oldH: null,
        canDrop: true,
        denyReason: "",
        ghost: null
    };

    e.preventDefault();
}

function startDrag() {
    const d = drag;
    d.active = true;

    document.body.classList.add("dragging-active");

    yard.querySelectorAll(".tier.hit,.tier.dim").forEach(t => t.classList.remove("hit", "dim"));

    const srcs = new Set();

    d.groupIds.forEach(id => {
        const x = DATA.find(z => z.id === id);
        if (x) srcs.add(x.block + "|" + x.bay);
    });

    d.groupIds.forEach(id => {
        const el = yard.querySelector('.tier[data-id="' + id + '"]');
        if (el) el.classList.add("dragging");
    });

    srcs.forEach(k => {
        const [bl, bay] = k.split("|");

        yard.querySelectorAll('.stack-col[data-block="' + bl + '"][data-bay="' + bay + '"] .tier').forEach(t => {
            const dd = DATA.find(x => x.id === +t.dataset.id);
            const isRemoved = d.groupIds.includes(+t.dataset.id);

            if (dd && !isRemoved && d.groupIds.some(gid => {
                const g = DATA.find(z => z.id === gid);
                return g && g.block === dd.block && Number(g.bay) === Number(dd.bay) && dd.tier > g.tier;
            })) {
                t.classList.add("lifted");
            }
        });
    });

    const dd = DATA.find(x => x.id === d.id);
    const s = stateOf(dd.state);

    const g = document.createElement("div");
    g.className = "drag-ghost" + (d.group ? " group" : "");
    g.style.setProperty("--c", s.color);

    g.innerHTML = d.group
        ? `<div class="dg-box"><span class="gn">${d.groupIds.length}</span> ярус${d.groupIds.length > 1 && d.groupIds.length < 5 ? "а" : d.groupIds.length >= 5 ? "ов" : ""}${NO_SVG}</div>`
        : `<div class="dg-box">${String(dd.number || "").slice(2, 6)}${NO_SVG}</div>`;

    document.body.appendChild(g);
    d.ghost = g;

    moveGhost(d.startX, d.startY);
}

function moveGhost(x, y) {
    if (drag && drag.ghost) {
        drag.ghost.style.transform = `translate(${x}px,${y}px) translate(-50%,-58%) rotate(-4deg)`;
    }
}

function currentDropCol(x, y) {
    if (!drag || !drag.ghost) return null;

    drag.ghost.style.display = "none";
    let el = document.elementFromPoint(x, y);
    drag.ghost.style.display = "";

    if (!el) return null;

    const col = el.closest(".stack-col");
    if (!col) return null;

    if (drag.groupIds.some(gid => {
        const g = DATA.find(z => z.id === gid);
        return g && g.block === col.dataset.block && Number(g.bay) === Number(col.dataset.bay);
    })) {
        return null;
    }

    return col;
}

function simulateGroupDrop(ids, block, bay) {
    const order = ids
        .map(id => DATA.find(x => x.id === id))
        .filter(Boolean)
        .sort((a, b) => (a.block + a.bay).localeCompare(b.block + b.bay) || a.tier - b.tier);

    let h = topTier(block, bay);

    for (const d of order) {
        h++;
        const c = checkTierLimit(typeLabel(d), block, bay, h);
        if (!c.ok) return { ok: false, reason: c.reason };
    }

    return { ok: true };
}

function setDropTarget(col) {
    if (drag.curCol === col) return;

    clearDropTarget();

    if (!col) return;

    const block = col.dataset.block;
    const bay = +col.dataset.bay;

    let check;
    let newTier;

    if (drag.group) {
        check = simulateGroupDrop(drag.groupIds, block, bay);
        newTier = topTier(block, bay) + drag.groupIds.length;
    } else {
        newTier = topTier(block, bay) + 1;
        check = checkTierLimit(drag.movedName, block, bay, newTier);
    }

    drag.curCol = col;
    drag.canDrop = check.ok;
    drag.denyReason = check.reason || "";

    col.classList.add(check.ok ? "drop-target" : "drop-target-deny");

    const pile = col.querySelector(".pile");
    const oldH = +pile.style.height.replace("px", "") || 0;
    const needH = newTier * TSTEP;

    if (needH > oldH) pile.style.height = needH + "px";

    const slot = document.createElement("div");
    slot.className = "drop-slot" + (check.ok ? "" : " deny");
    slot.style.bottom = ((newTier - 1) * TSTEP) + "px";

    pile.appendChild(slot);

    drag.slot = slot;
    drag._pile = pile;
    drag._oldH = oldH;

    if (drag.ghost) drag.ghost.classList.toggle("deny", !check.ok);
}

function clearDropTarget() {
    if (!drag) return;

    if (drag.curCol) {
        drag.curCol.classList.remove("drop-target", "drop-target-deny");
    }

    if (drag.slot) {
        drag.slot.remove();
        drag.slot = null;
    }

    if (drag._pile && drag._oldH != null) {
        drag._pile.style.height = drag._oldH + "px";
        drag._pile = null;
        drag._oldH = null;
    }

    drag.curCol = null;
    drag.canDrop = true;
    drag.denyReason = "";

    if (drag.ghost) drag.ghost.classList.remove("deny");
}

function autoScroll(x, y) {
    const yr = yard.getBoundingClientRect();

    if (y < yr.top + 48) yard.scrollTop -= 14;
    else if (y > yr.bottom - 32) yard.scrollTop += 14;

    const row = drag.curCol ? drag.curCol.closest(".sb-row") : null;

    if (row) {
        const rr = row.getBoundingClientRect();

        if (x < rr.left + 40) row.scrollLeft -= 16;
        else if (x > rr.right - 40) row.scrollLeft += 16;
    }
}

function onPointerMove(e) {
    if (!drag) return;

    if (!drag.active) {
        if (Math.abs(e.clientX - drag.startX) + Math.abs(e.clientY - drag.startY) > DRAG_THRESHOLD) {
            startDrag();
        } else {
            return;
        }
    }

    moveGhost(e.clientX, e.clientY);
    setDropTarget(currentDropCol(e.clientX, e.clientY));
    autoScroll(e.clientX, e.clientY);
}

function onPointerUp() {
    if (!drag) return;

    const wasActive = drag.active;
    const targetCol = drag.curCol;
    const canDrop = drag.canDrop;
    const reason = drag.denyReason;
    const d = drag;

    if (!wasActive) {
        const id = d.id;
        cleanupDrag();
        openDrawer(id);
        return;
    }

    if (targetCol && canDrop) {
        const totalAbove = d.groupIds.reduce((s, id) => s + removedAboveFor(id), 0);
        const extra = totalAbove > 0
            ? ` · снято ${totalAbove} ярус${totalAbove > 1 && totalAbove < 5 ? "а" : totalAbove >= 5 ? "ов" : ""} сверху`
            : "";

        const src = DATA.find(x => x.id === d.id);
        const label = d.group
            ? `${d.groupIds.length} ярусов → ${targetCol.dataset.block}/${pad2(+targetCol.dataset.bay)}`
            : `${src.number} → ${targetCol.dataset.block}/${pad2(+targetCol.dataset.bay)}`;

        performMove(d.groupIds.slice(), targetCol.dataset.block, +targetCol.dataset.bay, label);

        if (d.group) clearSelection();

        toast((d.group ? `Переставлено ${d.groupIds.length} ярусов` : `Переставлен ${src.prefix} ${src.number}`) + `: ${label}${extra}`);

        cleanupDrag();
        updateStackHighlights();
        syncBulkUI();
    } else {
        cleanupDrag();

        if (targetCol && !canDrop) {
            toast("Перестановка запрещена: " + reason, true);
        }
    }
}

function cleanupDrag() {
    if (!drag) return;

    if (drag.ghost) drag.ghost.remove();

    document.body.classList.remove("dragging-active");

    clearDropTarget();

    yard.querySelectorAll(".tier.dragging,.tier.lifted").forEach(t => {
        t.classList.remove("dragging", "lifted");
    });

    drag = null;
}

/* ============================================================
   MARQUEE ВЫДЕЛЕНИЕ
============================================================ */

let marquee = null;

function overlap(a, b) {
    return !(a.right < b.left || b.right < a.left || a.bottom < b.top || b.bottom < a.top);
}

function onMarqueePointerDown(e) {
    if (view !== "stacks" || e.button !== 0) return;
    if (e.target.closest(".tier")) return;
    if ($("#drawer").classList.contains("open")) return;
    if (e.target.closest(".yard-bar") || e.target.closest(".undo-rail") || e.target.closest(".yard-legend")) return;

    marquee = {
        startX: e.clientX,
        startY: e.clientY,
        active: false,
        el: null,
        curSel: new Set(),
        byBlock: new Map(),
        raf: 0
    };

    e.preventDefault();
}

function buildMarqueeIndex() {
    const byBlock = new Map();

    yard.querySelectorAll(".stack-block").forEach(bl => {
        const name = bl.dataset.block;
        const arr = [];

        bl.querySelectorAll(".tier").forEach(t => {
            arr.push({ el: t, id: +t.dataset.id });
        });

        byBlock.set(name, { el: bl, tiers: arr });
    });

    marquee.byBlock = byBlock;
}

function startMarquee() {
    const m = marquee;
    m.active = true;

    buildMarqueeIndex();

    const el = document.createElement("div");
    el.className = "marquee";
    document.body.appendChild(el);
    m.el = el;

    yard.querySelectorAll(".tier.msel").forEach(t => t.classList.remove("msel"));

    selectedIds.clear();
    syncBulkUI();

    paintMarquee(m.startX, m.startY);
}

function paintMarquee(x, y) {
    const m = marquee;

    const l = Math.min(m.startX, x);
    const t = Math.min(m.startY, y);
    const r = Math.max(m.startX, x);
    const b = Math.max(m.startY, y);

    m.el.style.left = l + "px";
    m.el.style.top = t + "px";
    m.el.style.width = (r - l) + "px";
    m.el.style.height = (b - t) + "px";

    const mrect = { left: l, top: t, right: r, bottom: b };
    const newSel = new Set();

    m.byBlock.forEach(info => {
        const br = info.el.getBoundingClientRect();
        if (!overlap(br, mrect)) return;

        info.tiers.forEach(o => {
            const tr = o.el.getBoundingClientRect();
            if (overlap(tr, mrect)) newSel.add(o.id);
        });
    });

    newSel.forEach(id => {
        if (!m.curSel.has(id)) {
            const o = findTierEl(m, id);
            if (o) o.el.classList.add("marquee-sel");
        }
    });

    m.curSel.forEach(id => {
        if (!newSel.has(id)) {
            const o = findTierEl(m, id);
            if (o) o.el.classList.remove("marquee-sel");
        }
    });

    m.curSel = newSel;
}

function findTierEl(m, id) {
    for (const info of m.byBlock.values()) {
        const o = info.tiers.find(t => t.id === id);
        if (o) return o;
    }

    return null;
}

function marqueeAutoScroll(y) {
    const yr = yard.getBoundingClientRect();

    if (y < yr.top + 44) yard.scrollTop -= 12;
    else if (y > yr.bottom - 30) yard.scrollTop += 12;
}

function onMarqueeMove(e) {
    if (!marquee) return;

    if (!marquee.active) {
        if (Math.abs(e.clientX - marquee.startX) + Math.abs(e.clientY - marquee.startY) > DRAG_THRESHOLD) {
            startMarquee();
        } else {
            return;
        }
    }

    marqueeAutoScroll(e.clientY);

    if (!marquee.raf) {
        const x = e.clientX;
        const y = e.clientY;

        marquee.raf = requestAnimationFrame(() => {
            marquee.raf = 0;
            paintMarquee(x, y);
        });
    }
}

function onMarqueeUp() {
    if (!marquee) return;

    const wasActive = marquee.active;
    const sel = marquee.curSel;

    if (marquee.el) marquee.el.remove();

    if (marquee.raf) {
        cancelAnimationFrame(marquee.raf);
        marquee.raf = 0;
    }

    marquee = null;

    if (!wasActive) {
        clearSelection();
        return;
    }

    yard.querySelectorAll(".tier.marquee-sel").forEach(t => {
        t.classList.remove("marquee-sel");
        t.classList.add("msel");
    });

    sel.forEach(id => selectedIds.add(id));

    syncBulkUI();
}

yard.addEventListener("pointerdown", onTierPointerDown);
yard.addEventListener("pointerdown", onMarqueePointerDown);

window.addEventListener("pointermove", e => {
    onPointerMove(e);
    onMarqueeMove(e);
});

window.addEventListener("pointerup", () => {
    onPointerUp();
    onMarqueeUp();
});

window.addEventListener("pointercancel", () => {
    if (drag && drag.active) cleanupDrag();

    if (marquee) {
        if (marquee.el) marquee.el.remove();
        marquee = null;
    }
});

