function initCombobox(inputId, listId, containerId, getDataFn) {
    const input = document.getElementById(inputId);
    const list = document.getElementById(listId);
    const container = document.getElementById(containerId);

    if (!input || !list || !container) return;

    const toggleList = show => {
        if (show) {
            container.classList.add("open");
            renderOptions(input.value);
        } else {
            setTimeout(() => container.classList.remove("open"), 150);
        }
    };

    const renderOptions = (filterText = "") => {
        const items = getDataFn() || [];
        const filter = String(filterText || "").toUpperCase();

        const filtered = items
            .map(item => typeof item === "string" ? item : item.caption)
            .filter(Boolean)
            .filter(val => !isJunkType(val))
            .filter(val => val.toUpperCase().includes(filter))
            .sort((a, b) => a.localeCompare(b, "ru"));

        const limited = filtered.slice(0, 80);

        list.innerHTML = limited.map(val => {
            const selected = val === input.value ? "selected" : "";
            return `<div class="option ${selected}" data-value="${val}">${val}</div>`;
        }).join("");

        if (!limited.length) {
            list.innerHTML = `<div class="option" style="color:var(--muted);cursor:default;">Ничего не найдено</div>`;
        }
    };

    input.addEventListener("focus", () => toggleList(true));
    input.addEventListener("click", () => toggleList(true));

    document.addEventListener("click", e => {
        if (!container.contains(e.target)) toggleList(false);
    });

    input.addEventListener("input", e => {
        renderOptions(e.target.value);
        container.classList.add("open");
    });

    list.addEventListener("click", e => {
        const option = e.target.closest(".option");
        if (!option || !option.dataset.value) return;

        input.value = option.dataset.value;
        toggleList(false);
        input.dispatchEvent(new Event("input"));
    });
}

/* ============================================================
   ОБЩИЕ HELPERS
============================================================ */

function typeAttrs(caption) {
    const c = String(caption || "").toUpperCase();

    if (c.includes("40") || c.includes("HC") || c.includes("1AX")) return { pw: 3900, maxStack: 7 };
    if (c.includes("РЕФР") || c.includes("R1")) return { pw: 3050, maxStack: 7 };
    if (c.includes("ТАНК") || c.includes("T1")) return { pw: 3600, maxStack: 7 };
    if (c.includes("OPEN") || c.includes("U1") || c.includes("OT")) return { pw: 2350, maxStack: 7 };

    return { pw: 2300, maxStack: 7 };
}

function typeLabel(d) {
    return d.typeLegacy || d.iso || "—";
}

function tierLimitByItem(d) {
    return Math.min(HARD_MAX, typeAttrs(typeLabel(d)).maxStack);
}

function topTier(block, bay) {
    let m = 0;

    for (const d of DATA) {
        if (d.block === block && Number(d.bay) === Number(bay) && Number(d.tier) > m) {
            m = Number(d.tier);
        }
    }

    return m;
}

function isProblem(d) {
    return d.state === "damaged" || d.state === "repair";
}

function dispWeight(d) {
    return d.gross != null ? d.gross : (d.tareFact != null ? d.tareFact : (d.pw || 0));
}

function hasDoc(d, t) {
    return (d.docs || []).some(x => x.type === t);
}

function typeCaptions() {
    const m = new Map();

    DATA.forEach(d => {
        const k = d.typeLegacy || "—";
        if (isJunkType(k)) return;
        m.set(k, (m.get(k) || 0) + 1);
    });

    return Array.from(m.entries()).sort((a, b) => a[0].localeCompare(b[0], "ru"));
}

function compactStack(block, bay) {
    const items = DATA
        .filter(d => d.block === block && Number(d.bay) === Number(bay))
        .sort((a, b) => a.tier - b.tier);

    items.forEach((d, i) => d.tier = i + 1);
}

function checkTierLimit(name, block, bay, newTier) {
    if (newTier > HARD_MAX) {
        return { ok: false, reason: `превышен абсолютный предел площадки (${HARD_MAX} ярусов)` };
    }

    const lt = Math.min(HARD_MAX, typeAttrs(name).maxStack);

    if (newTier > lt) {
        return { ok: false, reason: `для типа «${name}» допустимо ≤ ${lt} ярусов` };
    }

    if (newTier > 1) {
        const under = DATA.find(x => x.block === block && Number(x.bay) === Number(bay) && Number(x.tier) === newTier - 1);

        if (under) {
            const lu = tierLimitByItem(under);

            if (newTier > lu) {
                return { ok: false, reason: `нижний контейнер (${typeLabel(under)}) выдерживает ≤ ${lu} ярусов` };
            }
        }
    }

    return { ok: true };
}

