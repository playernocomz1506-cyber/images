function heatColor(p) {
    const h = 120 - (Math.min(1, p) * 120);
    return `hsl(${h} 62% 42%)`;
}

function renderAnalytics() {
    const blocks = groupBlocks();
    const blockNames = [...blocks.keys()].sort((a, b) => a.localeCompare(b));

    const heat = blockNames.map(name => {
        const bays = blocks.get(name) || new Map();
        let total = 0;
        let prob = 0;

        bays.forEach(arr => arr.forEach(d => {
            total++;
            if (isProblem(d)) prob++;
        }));

        const p = total ? prob / total : 0;

        return { name, total, prob, p };
    });

    $("#ax-heat-q").textContent = `проблемных ярусов · всего ${fmt(DATA.length)}`;

    $("#ax-heat-list").innerHTML = heat.map(h => {
        const pct = Math.round(h.p * 100);

        return `<div class="heat-row" data-block="${h.name}">
            <span class="hb">${h.name}</span>
            <div class="hbar"><i style="background:${heatColor(h.p)}" data-w="${pct}"></i></div>
            <span class="hpct">${h.prob}/${h.total}</span>
        </div>`;
    }).join("");

    requestAnimationFrame(() => {
        $("#ax-heat-list").querySelectorAll(".hbar i").forEach(i => {
            i.style.width = Math.max(3, +i.dataset.w) + "%";
        });
    });

    $("#ax-heat-list").querySelectorAll(".heat-row").forEach(r => {
        r.onclick = () => {
            closeAnalytics();
            aimBlock(r.dataset.block);
        };
    });

    const bn = [];

    blocks.forEach(bays => bays.forEach(arr => {
        const maxT = arr.length ? Math.max(...arr.map(d => d.tier)) : 0;

        arr.forEach(d => {
            if (isProblem(d)) {
                const buried = maxT - d.tier;
                bn.push({
                    d,
                    buried,
                    score: buried + (d.state === "damaged" ? 2 : 1)
                });
            }
        });
    }));

    bn.sort((a, b) => b.score - a.score);

    const top = bn.slice(0, 12);

    $("#ax-bn-q").textContent = bn.length ? `${bn.length} шт.` : "нет";

    $("#ax-bn-list").innerHTML = top.length ? top.map(o => {
        const s = stateOf(o.d.state);

        return `<div class="bn">
            <span class="sw" style="background:${s.color}"></span>
            <span class="bn-id">${o.d.prefix} ${o.d.number} · ${o.d.block}/${pad2(o.d.bay)}/T${o.d.tier}</span>
            <span class="bn-cost">снять ${o.buried}</span>
        </div>`;
    }).join("") : `<div class="ax-empty">Проблемных ярусов под завалом нет.</div>`;

    const buckets = [0, 0, 0, 0];
    let stacks = 0;

    blocks.forEach(bays => bays.forEach(arr => {
        if (!arr.length) return;

        stacks++;

        const cur = Math.max(...arr.map(d => d.tier));
        const cap = Math.min(...arr.map(d => tierLimitByItem(d)));
        const free = Math.max(0, cap - cur);

        buckets[Math.min(3, free)]++;
    }));

    const labels = ["0 (впритык)", "1", "2", "3+"];
    const colors = ["var(--danger)", "#d98200", "var(--accent)", "#3a9c8c"];
    const maxB = Math.max(1, ...buckets);

    $("#ax-hist").innerHTML = buckets.map((v, i) => {
        const hp = Math.round(v / maxB * 100);

        return `<div class="col">
            <span class="cv">${v}</span>
            <div class="bar" style="background:${colors[i]}" data-h="${hp}"></div>
            <span class="cl">${labels[i]}</span>
        </div>`;
    }).join("");

    requestAnimationFrame(() => {
        $("#ax-hist").querySelectorAll(".bar").forEach(b => {
            b.style.height = Math.max(4, +b.dataset.h) + "%";
        });
    });

    $("#ax-sub").textContent = `${blockNames.length} секций · ${stacks} штабелей` + (planMode ? " · черновик" : "");
}

function aimBlock(name) {
    if (view !== "stacks") return;

    const bl = yard.querySelector('.stack-block[data-block="' + name + '"]');

    if (bl) {
        bl.scrollIntoView({ block: "center", behavior: "smooth" });
        bl.classList.remove("aim");
        void bl.offsetWidth;
        bl.classList.add("aim");

        setTimeout(() => bl.classList.remove("aim"), 1400);
    }
}

function findFreeSlot(caption) {
    for (const [n, lay] of LAYOUT) {
        for (const bn of lay.bays) {
            const nt = topTier(n, bn) + 1;

            if (checkTierLimit(caption, n, bn, nt).ok) {
                return { block: n, bay: bn, tier: nt };
            }
        }
    }

    return { block: [...LAYOUT.keys()][0] || "A", bay: 1, tier: 1 };
}

